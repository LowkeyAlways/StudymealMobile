# Valeur fournie par le projet Sentry. Ne mets jamais une vraie valeur dans Git.
EXPO_PUBLIC_SENTRY_DSN=

# Utilisés uniquement lors des builds / uploads de source maps.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Clé Google Maps Android, requise uniquement pour afficher la carte dans une build Android.
GOOGLE_MAPS_ANDROID_API_KEY=

# Valeurs publiques du projet Supabase. Elles sont utilisables côté application
# uniquement si les règles RLS Supabase protègent correctement les données.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
