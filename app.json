{
  "expo": {
    "name": "Studymeal",
    "slug": "studymeal",
    "scheme": "studymeal",
    "experiments": {
      "typedRoutes": true
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/studymeal-icon.png",
    "primaryColor": "#0C5B4C",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/studymeal-icon.png",
      "supportsTablet": true
    },
    "android": {
      "icon": "./assets/studymeal-icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#FBFAF5",
        "foregroundImage": "./assets/studymeal-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/studymeal-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Studymeal utilise votre position uniquement pour calculer un itinéraire à pied vers un lieu."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFAF5",
          "image": "./assets/studymeal-icon-foreground.png",
          "imageWidth": 180
        }
      ]
    ]
  }
}
